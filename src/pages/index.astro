---
import BaseLayout from '../Layouts/Baselayout.astro';
const allPosts = Object.values(import.meta.glob('./posts/*.md', { eager: true }));
const uniqueTags = [...new Set(allPosts.flatMap((post: any) => post.frontmatter.tags ?? []))];
const pageTitle = "Home Page";
---
<BaseLayout pageTitle={pageTitle}>
  <section class="hero">
    <div class="hero-inner hero-grid">
      <div class="hero-copy">
        <div class="tags">
          {uniqueTags.map((tag) => (
            <p class="tag"><a href={`/tags/${tag}`}>{tag}</a></p>
          ))}
        </div>
        <h2 class="hero-sub">My awesome blog subtitle</h2>
        <p class="hero-intro">Welcome to my latest writing, projects, and technical notes. Explore posts by tag and discover the ideas I’m sharing.</p>
      </div>
    </div>
  </section>
</BaseLayout>